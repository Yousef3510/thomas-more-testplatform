# Kopieer dit bestand naar .env en pas de waarden aan
PORT=3000

# Gebruik een lange, willekeurige string in productie
JWT_SECRET=verander-dit-naar-een-lange-geheime-string

# --- AI-vraaggeneratie ---
# AI_PROVIDER: auto | openai | ollama | heuristic
#   auto     = gebruik OpenAI als er een sleutel is, anders Ollama als die ingesteld is, anders heuristiek
#   openai   = verplicht OpenAI
#   ollama   = verplicht een lokale Ollama-server (gratis, geen API-sleutel nodig)
#   heuristic= geen AI, enkel de ingebouwde regelgebaseerde motor
AI_PROVIDER=auto

# OpenAI (optioneel, betaald)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (optioneel, gratis & lokaal) - installeer Ollama en trek een model binnen:
#   ollama pull llama3.1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1